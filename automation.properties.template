# TAFLEX - Enterprise Test Automation Framework Configuration
# ==============================================================================
# This is a template configuration file.
# 1. Copy this file to 'automation.properties' in the project root.
# 2. Update the values to match your specific environment.
# Note: 'automation.properties' is gitignored and should NOT be committed.
# ==============================================================================

# ==============================================================================
# EXECUTION CONFIGURATION
# ==============================================================================

# Defines the primary automation strategy to use.
# Expected values: web | api | mobile
# Example: execution.mode=web
execution.mode=web

# Logical name for the current environment. Useful for logging and conditional logic.
# Expected values: dev | qa | staging | prod
# Example: environment=staging
environment=staging

# ==============================================================================
# WEB CONFIGURATION (Playwright)
# ==============================================================================

# The browser engine to use for web tests.
# Expected values: chromium | firefox | webkit
# Example: web.browser=chromium
web.browser=chromium

# If true, runs tests without a visible browser window. Recommended for CI.
# Expected values: true | false
# Example: web.headless=true
web.headless=false

# Global timeout for page operations (navigation, waiting) in seconds.
# Default: 30
web.timeout=30

# Base URL for your web application. navigateTo() uses this as a prefix if needed.
# Example: web.base.url=https://www.example.com
web.base.url=https://staging.example.com

# Generates a detailed trace file for each test. Can be opened with Playwright CLI.
# Expected values: true | false
web.tracing.enabled=false

# Default browser viewport size.
web.viewport.width=1920
web.viewport.height=1080

# ==============================================================================
# API CONFIGURATION (Apache HttpClient)
# ==============================================================================

# Root URL for all API requests. All endpoint locators will be appended to this.
# Example: api.base.url=https://api.example.com/v1
api.base.url=https://api.staging.example.com

# HTTP connection and socket timeout in seconds.
# Default: 30
api.timeout=30

# Default 'Content-Type' header for outgoing requests.
# Example: application/json | application/xml
api.content.type=application/json

# ==============================================================================
# MOBILE CONFIGURATION (Appium)
# ==============================================================================

# Target mobile operating system.
# Expected values: android | ios
mobile.platform=android

# Attempts to detect the platform automatically based on connected devices.
# If multiple devices are found, it falls back to 'mobile.platform'.
mobile.platform.auto=true

# The Appium server endpoint.
# Default: http://localhost:4723
mobile.appium.url=http://localhost:4723

# If true, the framework will try to start the Appium server automatically.
# Requires 'appium' to be in your PATH.
mobile.appium.auto.start=false

# Full path to the mobile application binary.
# Example: /Users/me/apps/my-app.apk | https://cloud.com/app.ipa
mobile.app.path=/path/to/your/app.apk

# Identifier for the mobile device or emulator.
# Example: Pixel_6_API_33 | iPhone 14 Pro
mobile.device.name=Pixel5

# --- Android-specific ---
# The package name and main activity of your app.
mobile.app.package=com.example.app
mobile.app.activity=com.example.app.MainActivity

# --- iOS-specific ---
# The Bundle Identifier of your app.
mobile.app.bundleId=com.example.app

# ==============================================================================
# DATABASE CONFIGURATION (HikariCP)
# ==============================================================================

# JDBC Connection URL.
# Examples: 
#   jdbc:postgresql://localhost:5432/testdb
#   jdbc:mysql://localhost:3306/testdb
db.url=

# Database credentials.
db.username=admin
db.password=password

# Maximum number of connections in the Hikari pool.
db.pool.size=10

# ==============================================================================
# CODE QUALITY & HYGIENE
# ==============================================================================

# Strategy for externalizing locators.
# Expected values: properties | json
locator.strategy=properties

# ==============================================================================
# REPORTING & GOVERNANCE
# ==============================================================================

# --- Allure ---
# Enable Allure results generation (*.json files).
allure.enabled=true
allure.results.directory=build/allure-results

# --- ReportPortal ---
# Enable native ReportPortal integration.
reportportal.enabled=false
reportportal.endpoint=http://localhost:8080
reportportal.api.key=your_api_key
reportportal.project=test_automation
reportportal.launch=TAFLEX_Main_Run

# --- Xray (Jira) ---
# Enable Xray Cloud API integration for traceability.
# TAFLEX automatically exchanges the Client ID/Secret for a temporary JWT token.
xray.enabled=false
xray.client.id=your_client_id
xray.client.secret=your_client_secret

# ==============================================================================
# EXECUTION CONTROL
# ==============================================================================

# Enable parallel execution via TestNG.
parallel.enabled=true
parallel.threads=4

# Automatically retry failed tests.
retry.enabled=true
retry.max.attempts=2

# Capture a screenshot automatically when a UI test fails.
# Saved to the 'screenshots/' directory.
screenshot.on.failure=true

# ==============================================================================
# LOGGING
# ==============================================================================

# Framework log level.
# Expected values: TRACE | DEBUG | INFO | WARN | ERROR
log.level=INFO

# Output logs to the system console.
log.console=true

# Save logs to a physical file.
log.file=true
log.file.path=logs/test-automation.log
