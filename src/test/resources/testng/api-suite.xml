<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Test Suite" parallel="methods" thread-count="4">
    
    <listeners>
        <listener class-name="io.github.vinipx.taflex.listeners.TestListener"/>
        <listener class-name="io.github.vinipx.taflex.listeners.AnnotationTransformer"/>
        <!-- Report Portal Listener (uncomment when configured) -->
        <!-- <listener class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/> -->
    </listeners>
    
    <test name="API Tests">
        <parameter name="execution.mode" value="api"/>
        <classes>
            <class name="io.github.vinipx.taflex.tests.api.UserApiTests"/>
            <class name="io.github.vinipx.taflex.tests.api.OrderApiTests"/>
        </classes>
    </test>
    
</suite>