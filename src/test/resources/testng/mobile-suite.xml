<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Test Suite" parallel="methods" thread-count="2">
    
    <listeners>
        <listener class-name="com.enterprise.taflex.listeners.TestListener"/>
        <listener class-name="com.enterprise.taflex.listeners.AnnotationTransformer"/>
        <!-- Report Portal Listener (uncomment when configured) -->
        <!-- <listener class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/> -->
    </listeners>
    
    <test name="Mobile Tests">
        <parameter name="execution.mode" value="mobile"/>
        <classes>
            <class name="com.enterprise.taflex.tests.mobile.MobileLoginTests"/>
            <class name="com.enterprise.taflex.tests.mobile.MobileNavigationTests"/>
        </classes>
    </test>
    
</suite>