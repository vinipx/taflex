<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Web Test Suite" parallel="methods" thread-count="4">
    
    <listeners>
        <listener class-name="com.enterprise.taflex.listeners.TestListener"/>
        <listener class-name="com.enterprise.taflex.listeners.AnnotationTransformer"/>
        <!-- Report Portal Listener (uncomment when configured) -->
        <!-- <listener class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/> -->
    </listeners>
    
    <test name="Web Tests">
        <parameter name="execution.mode" value="web"/>
        <classes>
            <class name="com.enterprise.taflex.tests.web.LoginTests"/>
            <class name="com.enterprise.taflex.tests.web.DashboardTests"/>
        </classes>
    </test>
    
</suite>